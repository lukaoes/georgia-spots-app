{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.vanlife.ge/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://api.vanlife.ge/api/sitemap.xml" },
    { "source": "/place/:id", "destination": "https://api.vanlife.ge/api/og/place/:id" },
    { "source": "/users/:username", "destination": "https://api.vanlife.ge/api/og/profile/:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
